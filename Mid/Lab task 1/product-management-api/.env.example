# Core Environment Settings
NODE_ENV=development               # Node.js environment (development | production)
NODE_DB_ENV=development            # Database environment mode
JWT_BEARER_SECRET="change-me"      # Required by the config loader (not used by the product/employee APIs)
PORT=5001                          # Port on which the backend HTTP server will run

# Database Configuration (PostgreSQL)
DB_CLIENT="postgres"
DB_DATABASE="product_management"
DB_USER="postgres"
DB_PASSWORD="your_db_password"
DB_HOST="localhost"
DB_PORT="5432"

# Redis Configuration (optional; no queues are registered by this project)
REDIS_PORT=6379
REDIS_HOST="localhost"
REDIS_URL=

# Email Server Configuration (keys must exist, values may stay empty)
MAILER_HOST=
MAILER_PORT=
MAILER_SECURE=
MAILER_USER=
MAILER_PASSWORD=
MAILER_FROM=
